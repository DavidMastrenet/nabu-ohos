declare_args() {
  drivers_interface_display_community = false
  drivers_interface_display_hicollie_enable = false
  drivers_interface_display_vdi_default = false
  drivers_interface_display_dpu_composer = false
  drivers_interface_display_support_online = true
}

if (drivers_interface_display_community) {
  display_defines = [ "DISPLAY_COMMUNITY" ]
} else {
  display_defines = []
}

if (drivers_interface_display_vdi_default) {
  display_defines += [
    "COMPOSER_VDI_DEFAULT_LIBRARY_ENABLE",
    "BUFFER_VDI_DEFAULT_LIBRARY_ENABLE",
  ]
}

if (!drivers_interface_display_community) {
  drivers_interface_display_hicollie_enable = true
  display_defines += [ "DISPLAY_HICOLLIE_ENABLE" ]
}

if (drivers_interface_display_dpu_composer) {
  display_defines += [ "DISPLAY_DPU_COMPOSER" ]
}

if (drivers_interface_display_support_online) {
  display_defines += [ "DISPLAY_SUPPORT_ONLINE" ]
}