/**
 * @addtogroup HdiDisplay
 *
 * @brief Define the color space Key interface of the display module.
 *
 * This module provides the color space types used by the driver interface for the upper-level graphics service.
 *
 * @since 7.0
 * @version 2.4
 */

/**
 * @file CMColorSpace.idl
 * @brief Declares the color space types used by the interfaces related to color space Meta Key operations.
 *
 */

package ohos.hdi.display.graphic.common.v2_4;
import ohos.hdi.display.graphic.common.v2_0.CMColorSpace;


/**
 * @brief control the linear/non-linear color convert, nick named gamma function.
 *
 */
enum CM_TransFunc : ohos.hdi.display.graphic.common.v2_0.CM_TransFunc {
    TRANSFUNC_LOG = 9,
};

/**
 * @brief Defines color space information structure.
 *
 * This structure contains the basic attributes of a color space, including color primaries,
 * transfer function, conversion matrix, and range. It is used to describe the color characteristics.
 */ 
struct CM_ColorSpaceInfo {
    enum CM_ColorPrimaries primaries;
    enum CM_TransFunc      transfunc;
    enum CM_Matrix         matrix;
    enum CM_Range          range;
};

/**
 * @brief Defines color space type enumeration.
 *
 * This enum provides predefined color space types that combine color primaries, transfer function,
 * conversion matrix, and range.
 */
enum CM_ColorSpaceType : ohos.hdi.display.graphic.common.v2_0.CM_ColorSpaceType {
    CM_BT2020_LOG_FULL  = 4 | (9 << 8) | (4 << 16) | (1 << 21), // COLORPRIMARIES_BT2020 | (TRANSFUNC_LOG << 8) | (MATRIX_BT2020 << 16) | (RANGE_FULL << 21)
    CM_BT2020_LOG_LIMIT = 4 | (9 << 8) | (4 << 16) | (2 << 21), // COLORPRIMARIES_BT2020 | (TRANSFUNC_LOG << 8) | (MATRIX_BT2020 << 16) | (RANGE_LIMITED << 21)
};